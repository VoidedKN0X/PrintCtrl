    <!-- Errors -->
    <string name="err_pin_changed">The server\'s certificate has changed since you trusted it. If you replaced it yourself, open the server under Account › Servers and trust the new one.</string>
    <string name="err_unauthorized">The server refused the API key. Check it under Account › Servers.</string>
    <string name="err_forbidden">Not allowed with this API key. %1$s Turn on the matching permission for the key in Bambuddy (Settings › API Keys).</string>
    <string name="err_not_found">Not found on the server. It may have been removed, or the server is an older version.</string>
    <string name="err_gone">The server no longer supports this. Update PrintCtrl, or check the server version.</string>
    <string name="err_server">The server answered with an error (%1$d). %2$s</string>
    <string name="err_not_bambuddy">Something answered at this address, but it isn\'t Bambuddy. Check the address and port.</string>
    <string name="err_not_spoolman">Something answered at this address, but it isn\'t Spoolman. Check the address and port.</string>
    <string name="err_certificate">The server\'s certificate isn\'t trusted by this phone.</string>
    <string name="err_unknown_host">Can\'t find the server. Check the address and that you\'re on the right network.</string>
    <string name="err_refused">Connection refused. Is the server running, and is the port right?</string>
    <string name="err_timeout">The server took too long to answer.</string>
    <string name="err_tls">Secure connection failed: %1$s</string>
    <string name="err_network">Network error</string>
    <string name="err_generic">Something went wrong</string>

    <!-- Welcome -->
    <string name="welcome_intro">Your Bambuddy printers and Spoolman spools in one app. Connect the server you use; you can add the other one later from your account page.</string>
    <string name="welcome_bambuddy">Printers, live camera, controls and errors</string>
    <string name="welcome_spoolman">Filament spools and what\'s left on them</string>
    <string name="welcome_either">Either server is enough on its own. PrintCtrl talks only to your servers, never to the printers directly.</string>

    <!-- Server setup -->
    <string name="setup_bambuddy_intro">Connect to your Bambuddy server with the address you\'d open in a browser and an API key.</string>
    <string name="setup_spoolman_intro">Connect to your Spoolman server with the address you\'d open in a browser.</string>
    <string name="setup_address">Server address</string>
    <string name="setup_address_hint_bambuddy">bambuddy.lan:8000</string>
    <string name="setup_address_hint_spoolman">spoolman.lan:7912</string>
    <string name="setup_second_address">Second address (optional)</string>
    <string name="setup_second_address_hint">bambuddy.example.com</string>
    <string name="setup_second_address_help">PrintCtrl uses the first address that answers, and checks again when your phone changes networks. Put your home address first and the one you use away from home second.</string>
    <string name="setup_api_key">API key</string>
    <string name="setup_secret_saved">Saved. Leave empty to keep it</string>
    <string name="setup_api_key_help">Create a key in Bambuddy under Settings › API Keys. Turn on Read Status to see your printers, and Control Printer to pause, resume and stop prints from here.</string>
    <string name="setup_username">Username (optional)</string>
    <string name="setup_password">Password (optional)</string>
    <string name="setup_proxy_login_help">Spoolman has no login of its own. Only fill these in if a reverse proxy in front of it asks for one.</string>
    <string name="setup_test_save">Test and save</string>
    <string name="setup_storage_note">Keys and passwords are stored encrypted on this phone and are only sent to this server.</string>
    <string name="setup_http_warning">Not encrypted (HTTP). Fine on your home network, risky anywhere else.</string>
    <string name="setup_bad_address">\"%1$s\" isn\'t a valid address.</string>
    <string name="setup_needs_key">This Bambuddy has logins turned on, so PrintCtrl needs an API key.</string>
    <plurals name="setup_ok_bambuddy">
        <item quantity="one">Connected to Bambuddy %1$s with %2$d printer.</item>
        <item quantity="other">Connected to Bambuddy %1$s with %2$d printers.</item>
    </plurals>
    <string name="setup_ok_spoolman">Connected to Spoolman %1$s.</string>
    <string name="http_title">Use an unencrypted connection?</string>
    <string name="http_body">PrintCtrl couldn\'t connect over HTTPS. It can use %1$s instead, but then your API key and everything else is sent unencrypted and anyone on the network can read it. Only do this on a network you trust.</string>
    <string name="http_confirm">Use HTTP</string>
    <string name="http_declined">Couldn\'t connect securely (HTTPS).</string>
    <string name="trust_title">Trust this certificate?</string>
    <string name="trust_body">%1$s uses a certificate this phone doesn\'t trust, such as a self-signed one. Only trust it if this fingerprint matches the one on your server:</string>
    <string name="trust_subject">Issued to %1$s. PrintCtrl will accept this exact certificate for this address only.</string>
    <string name="trust_confirm">Trust</string>
    <string name="partial_title">Some addresses didn\'t answer</string>
    <string name="partial_body">%1$s\n\nThis is normal for an address that only works away from home. Save anyway?</string>
    <string name="partial_confirm">Save</string>
    <string name="remove_server">Remove this server</string>
    <string name="remove_bambuddy_title">Remove Bambuddy?</string>
    <string name="remove_spoolman_title">Remove Spoolman?</string>
    <string name="remove_server_body">PrintCtrl forgets the address and key. Nothing changes on the server.</string>

